# ==========================================
# Lavanya Upakara — contoh environment variable
# Salin ke .env.local lalu isi nilainya.
# JANGAN commit .env.local yang berisi kunci asli.
# ==========================================

# --- Database (Postgres / Supabase) ---
DATABASE_URL=

# --- Better Auth ---
BETTER_AUTH_SECRET=
# HARUS alamat tempat aplikasi diakses, bukan localhost, saat di-deploy.
# Origin dari nilai ini otomatis dipercaya; kalau salah, semua login dan
# pendaftaran ditolak "Invalid origin".
#   lokal    : http://localhost:3000
#   produksi : https://lavanya-upakara-gamma.vercel.app
# Di Vercel boleh dikosongkan — alamat produksi terdeteksi otomatis.
BETTER_AUTH_URL=http://localhost:3000
# Opsional. Origin tambahan yang boleh memakai endpoint login, dipisah koma.
# Domain produksi dan preview Vercel sudah dipercaya otomatis lewat
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, jadi ini hanya perlu diisi
# kalau memakai domain kustom. Contoh: https://lavanyaupakara.com
AUTH_TRUSTED_ORIGINS=

# --- Asisten AI (Google Gemini) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Midtrans ---
# Ambil dari Dashboard Midtrans > Settings > Access Keys.
# Server Key HANYA di server; jangan pernah diberi awalan NEXT_PUBLIC_.
MIDTRANS_SERVER_KEY=
# Client Key dipakai snap.js di browser, jadi memang publik.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# "true" untuk memakai Midtrans Production, selain itu Sandbox.
# Keduanya harus diisi sama supaya server dan browser tidak beda lingkungan.
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# --- Bootstrap akun admin ---
# Hanya dipakai sekali oleh skrip `npm run db:seed-admin`, tidak dibaca oleh
# aplikasi yang berjalan. Isi lalu jalankan skripnya untuk membuat atau
# memperbarui satu akun admin; boleh dihapus dari .env.local setelahnya.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAMA=
